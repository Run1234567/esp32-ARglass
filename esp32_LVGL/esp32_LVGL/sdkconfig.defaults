CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192

# 减少 WiFi 缓冲区，为 BLE + LVGL 节省内存
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=5
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8

# LVGL 启用 Montserrat 48 字体
CONFIG_LV_FONT_MONTSERRAT_48=y
# LVGL 使用系统 malloc（利用 PSRAM 的 8MB 内存，彻底解决 OOM 问题）
CONFIG_LV_MEM_CUSTOM=y
# 抑制 I2C 废弃警告
CONFIG_I2C_SUPPRESS_DEPRECATE_WARN=y

# 启用 LEDC (PWM 马达控制)
CONFIG_SOC_LEDC_SUPPORTED=y

# 禁用编译器警告为错误（允许 C++ 隐式转换）
CONFIG_COMPILER_DISABLE_DEFAULT_WARNINGS=y

# 启用蓝牙
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y

# 启用 PSRAM（你的代码大量使用 MALLOC_CAP_SPIRAM）
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
